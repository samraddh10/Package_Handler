# Copy this file to .env and fill in what you have. Never commit .env.
# Blank values count as "not set".

# ---------------------------------------------------------------------------
# LLM providers (free tiers). A provider is used only when BOTH its API key
# and its model are set. Missing ones are skipped, so one provider is enough.
# ---------------------------------------------------------------------------

# Gemini: create a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Check which models are free in AI Studio before choosing.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_INPUT_TOKENS=200000

# Groq: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# The free tier allows about 8K tokens per minute, so bigger requests skip Groq.
GROQ_MAX_INPUT_TOKENS=6000

# OpenRouter: create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Pick a model ID ending in ":free" that supports tool calling.
OPENROUTER_MODEL=
OPENROUTER_MAX_INPUT_TOKENS=30000

# Order in which providers are tried when one is rate limited or down.
LLM_PROVIDER_ORDER=gemini,groq,openrouter
# Hard cap on LLM calls in a single run.
LLM_MAX_CALLS_PER_RUN=60

# ---------------------------------------------------------------------------
# GitHub: a fine-grained personal access token limited to your demo repos.
# Permissions: Contents (read/write), Pull requests (read/write),
# Issues (read/write, for labels), Metadata (read).
# The changelog reader works without it, but GitHub then allows only 60 API
# requests an hour per IP address (shared with anything else on your network),
# and packages without a CHANGELOG file need that API for their release notes.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Redis (changelog cache). Set REDIS_PASSWORD, then start it with:
# docker compose up -d redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Sandbox containers can reach Redis while npm install runs, so it needs a password.
# docker-compose.yml reads this too. Any long random string works, e.g. `openssl rand -hex 24`.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Docker sandbox: where installs and tests run
# ---------------------------------------------------------------------------
SANDBOX_IMAGE=node:22-bookworm
SANDBOX_CPUS=2
SANDBOX_MEMORY_MB=2048
INSTALL_TIMEOUT_SEC=300
TEST_TIMEOUT_SEC=300

# ---------------------------------------------------------------------------
# Fix agent limits
# ---------------------------------------------------------------------------
# Test runs after an edit, per package, before the agent gives up.
FIX_MAX_ATTEMPTS=3
# LLM calls (one model step each) per package.
FIX_MAX_STEPS=20
# Input + output tokens per package, summed over all its steps.
FIX_MAX_TOKENS=200000

# Folder for cloned target repos and run reports (git-ignored).
WORKSPACE_DIR=.workspaces
